# Machine Made Worlds — Hostinger secrets template
# Copy to .env (never commit .env) or export in your shell / CI secrets store.
# The Board injects these as HOSTINGER_FTP_* env vars before the first live push.
# NEVER invent credentials — ask the Board for the real values.

# Required
HOSTINGER_FTP_HOST=ftp.machinemadeworlds.com
HOSTINGER_FTP_USER=u123456789_machinemade
HOSTINGER_FTP_PASS=your-ftp-password-here

# Optional (defaults below)
HOSTINGER_FTP_PORT=21
HOSTINGER_FTP_PROTOCOL=ftp
# ftp  = plain FTP (Hostinger default, port 21)
# sftp = SFTP over SSH (port 22, if enabled on Hostinger)
# ftps = FTP over TLS (port 21, explicit TLS)

HOSTINGER_FTP_REMOTE_DIR=domains/machinemadeworlds.com/public_html
# Live docroot per SRE deploy evidence (MAC-220, 2026-09-08; first noted
# MAC-86): the FTP login dir /public_html is NOT live (DO_NOT_UPLOAD_HERE
# marker). Override this var only for other accounts.

# Approval gate — set to 1 after Board approves the publish in Paperclip
# BOARD_APPROVED=1

# Legacy fallback names (deprecated, but supported by deploy scripts):
# HOSTINGER_HOST, HOSTINGER_USER, HOSTINGER_PASS, HOSTINGER_PORT, HOSTINGER_REMOTE_DIR
