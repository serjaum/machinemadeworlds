Options -Indexes
ErrorDocument 404 /404.html
RewriteEngine On
# Legacy document URLs redirect instead of serving duplicate pages.
RewriteCond %{THE_REQUEST} \s/+(.+?)/index\.html[\s?] [NC]
RewriteRule ^(.+)/index\.html$ /$1/ [R=301,L]
RewriteRule ^index\.html$ / [R=301,L]
RewriteRule ^(about|blog)\.html$ /$1/ [R=301,L]
RewriteRule ^posts/([a-z0-9-]+)\.html$ /posts/$1/ [R=301,L]
<IfModule mod_headers.c>
  <FilesMatch "\.(html|xml|json|txt)$">
    Header set Cache-Control "public, max-age=0, must-revalidate"
  </FilesMatch>
  <FilesMatch "\.[a-f0-9]{12}\.(css|js|svg)$">
    Header set Cache-Control "public, max-age=31536000, immutable"
  </FilesMatch>
  Header set X-Content-Type-Options "nosniff"
  Header set Referrer-Policy "strict-origin-when-cross-origin"
</IfModule>
<IfModule mod_deflate.c>
  AddOutputFilterByType DEFLATE text/html text/css text/javascript application/javascript application/json application/xml image/svg+xml text/plain
</IfModule>
